  "units": [
    {
      "id": "CK12-SCI-008-U001",
      "label": "Title: States of Matter",
      "type": "text",
      "duration": 3.0,
      "content_summary": "Lesson title"
    },
    {
      "id": "CK12-SCI-008-U002",
      "label": "Definition: three common states (text)",
      "type": "text",
      "duration": 24.0,
      "content_summary": "Matter exists in three common states: solid (fixed shape and volume), liquid (fixed volume, takes shape of container), gas (no fixed shape or volume). State depends on particle arrangement and energy."
    },
    {
      "id": "CK12-SCI-008-U003",
      "label": "Particle arrangement diagram (image)",
      "type": "image",
      "duration": 15.0,
      "content_summary": "Three-panel diagram: solid particles in tight fixed lattice, liquid particles close but mobile, gas particles far apart and moving freely."
    },
    {
      "id": "CK12-SCI-008-U004",
      "label": "Video: water changing states (video)",
      "type": "video",
      "duration": 60.0,
      "content_summary": "Time-lapse video of ice melting into water then boiling into steam, showing the particle-level animation overlaid on the real footage."
    },
    {
      "id": "CK12-SCI-008-U005",
      "label": "State-change vocabulary (text)",
      "type": "text",
      "duration": 24.0,
      "content_summary": "Melting (solid→liquid), freezing (liquid→solid), evaporation (liquid→gas), condensation (gas→liquid), sublimation (solid→gas directly, e.g. dry ice)."
    },
    {
      "id": "CK12-SCI-008-U006",
      "label": "Practice: identify state changes (text)",
      "type": "text",
      "duration": 18.0,
      "content_summary": "Four scenarios: dew forming on grass, ice cubes melting, puddle drying up, dry ice fog. Identify the state change in each."
    },
    {
      "id": "CK12-SCI-008-U007",
      "label": "Lesson root: States of Matter",
      "type": "text",
      "duration": 3.0,
      "content_summary": "Top-level document container."
    }
