  "units": [
    {
      "id": "CK12-SCI-009-U001",
      "label": "Title: Photosynthesis Basics",
      "type": "text",
      "duration": 3.0,
      "content_summary": "Lesson title"
    },
    {
      "id": "CK12-SCI-009-U002",
      "label": "Definition and equation (text)",
      "type": "text",
      "duration": 30.0,
      "content_summary": "Photosynthesis is the process by which plants convert light energy into chemical energy. Equation: 6CO2 + 6H2O + light → C6H12O6 + 6O2. Occurs in chloroplasts using chlorophyll."
    },
    {
      "id": "CK12-SCI-009-U003",
      "label": "Leaf cross-section diagram (image)",
      "type": "image",
      "duration": 15.0,
      "content_summary": "Cross-section of a leaf showing chloroplasts in mesophyll cells, stomata for gas exchange, and veins for water/sugar transport."
    },
    {
      "id": "CK12-SCI-009-U004",
      "label": "Video: photosynthesis animation (video)",
      "type": "video",
      "duration": 75.0,
      "content_summary": "Animated video showing CO2 entering through stomata, water absorbed by roots, sunlight captured by chlorophyll, and glucose/oxygen produced."
    },
    {
      "id": "CK12-SCI-009-U005",
      "label": "Practice: label the inputs/outputs (text)",
      "type": "text",
      "duration": 18.0,
      "content_summary": "Diagram-based question: label which arrows represent inputs (CO2, water, light) and outputs (glucose, oxygen) in a given photosynthesis diagram."
    },
    {
      "id": "CK12-SCI-009-U006",
      "label": "Lesson root: Photosynthesis Basics",
      "type": "text",
      "duration": 3.0,
      "content_summary": "Top-level document container."
    }
